    "hasSmallAmount": {
      "relevant": 0.28,
      "irrelevant": 0.32
    }
  },
  "keywordWeights": {
    "$comment": "Share of the keyword score per field. withTags/withoutTags are used by the US matcher depending on whether the grant carries tags; EU_FUNDING is used by the EU matcher.",
    "withTags": {
      "title": 0.4,
      "description": 0.25,
      "agency": 0.15,
      "tags": 0.2
    },
    "withoutTags": {
      "title": 0.5,
      "description": 0.3125,
      "agency": 0.1875,
      "tags": 0.0
    },
    "EU_FUNDING": {
      "title": 0.5,
      "description": 0.3,
      "agency": 0.2,
      "tags": 0.0
    }
  },
  "profileBoosts": {
    "$comment": "Confidence boosts on the likelihood ratio when the researcher profile carries these fields (bc/common/matching.py).",
    "keywords": 1.08,
    "optimizedKeywords": 1.03,
    "agencies": 1.04
  },
  "features": {
    "$comment": "Boolean features a grant can have (bc/common/matching.py extract_grant_features). anyOf = case-insensitive substring match over the listed fields ('combined' = title + agency + description); amount = band on the award amount (awardCeiling or amount; never matches when the amount is missing/non-numeric). Keys must match featureLikelihoods.",
