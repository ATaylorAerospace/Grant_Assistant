{
  "$comment": "Everything the grant matcher (bc/common/matching.py) needs: feature definitions, priors, likelihoods, keyword weights, per-source behaviour. Values were lifted verbatim from the original code; tune here, not there. Keep likelihood ratios small (1.5-3x): matched features multiply.",
  "researcherPriors": {
    "$comment": "Base P(relevant) by researcher type; default applies to unknown types.",
    "biomedical": 0.2,
    "engineering": 0.15,
    "social_science": 0.1,
    "basic_science": 0.12,
    "computer_science": 0.15,
    "default": 0.1
