      "irrelevant": 0.12
    },
    "isNSF": {
      "relevant": 0.28,
      "irrelevant": 0.14
    },
    "isDOD": {
      "relevant": 0.25,
      "irrelevant": 0.12
    },
    "isDOE": {
      "relevant": 0.22,
      "irrelevant": 0.12
    },
    "isEmbassy": {
      "relevant": 0.05,
      "irrelevant": 0.15
    },
    "isBiomedical": {
      "relevant": 0.35,
      "irrelevant": 0.14
    },
    "isEngineering": {
      "relevant": 0.32,
      "irrelevant": 0.16
    },
    "isBasicScience": {
      "relevant": 0.25,
      "irrelevant": 0.14
    },
    "isAlzheimers": {
      "relevant": 0.3,
      "irrelevant": 0.12
    },
    "isCancer": {
      "relevant": 0.32,
      "irrelevant": 0.13
    },
    "isAI": {
      "relevant": 0.34,
      "irrelevant": 0.17
    },
    "isClimateChange": {
      "relevant": 0.28,
      "irrelevant": 0.14
    },
    "isSmallBusiness": {
      "relevant": 0.2,
      "irrelevant": 0.12
