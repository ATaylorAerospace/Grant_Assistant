  "sources": {
    "$comment": "Per-source matcher behaviour. keywordWeights: a keywordWeights key, or 'auto' (withTags/withoutTags by whether the grant has tags). relevanceScore: 'keyword' or 'profile'. defaultProfileFallback: score users without a profile against the shared default profile.",
    "GRANTS_GOV": {
      "keywordWeights": "auto",
      "relevanceScore": "keyword",
      "defaultProfileFallback": false
    },
    "EU_FUNDING": {
      "keywordWeights": "EU_FUNDING",
      "relevanceScore": "profile",
      "defaultProfileFallback": true
    }
