{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CdkBootstrapAndCloudFormation",
      "Effect": "Allow",
      "Action": [
        "cloudformation:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CdkAssumeBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/cdk-*"
    },
    {
      "Sid": "AmplifyBackendServices",
      "Effect": "Allow",
      "Action": [
        "amplify:*",
        "appsync:*",
        "cognito-idp:*",
        "cognito-identity:*",
        "dynamodb:*",
        "lambda:*",
        "events:*",
        "scheduler:*",
        "states:*",
        "sqs:*",
        "logs:*",
        "cloudwatch:*",
        "ssm:GetParameter*",
        "ssm:PutParameter",
        "ssm:DeleteParameter*",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource",
        "ssm:DescribeParameters"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StorageAndContainers",
      "Effect": "Allow",
      "Action": [
        "s3:*",
        "ecr:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AiServices",
      "Effect": "Allow",
      "Action": [
        "bedrock:*",
        "bedrock-agentcore:*",
        "aoss:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EdgeAndBuild",
      "Effect": "Allow",
      "Action": [
        "wafv2:*",
        "codebuild:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IamForStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:GetRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:CreatePolicy",
        "iam:DeletePolicy",
        "iam:GetPolicy",
        "iam:GetPolicyVersion",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicyVersion",
        "iam:ListPolicyVersions",
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": "*"
    }
  ]
}
